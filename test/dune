(rule
 (alias runtest)
 (deps
  unitcon
  deps
  mvn/pom.xml
  (source_tree mvn/src)
  (source_tree mvn/unitcon-properties))
 (targets mvn.output)
 (action
  (progn
   (ignore-stdout
    (run
     ./unitcon
     run
     mvn
     --target
     src/main/java/example/Checker.java:25
     --batch-size
     1
     --out-dir
     unitcon-mvn
     --ignore-time
     --ignore-stdlib))
   (run cp unitcon-mvn/unitcon-tests/UnitconTest1.java %{targets}))))

(rule
 (alias runtest)
 (action
  (diff mvn.expected mvn.output)))

(test
 (name unit)
 (libraries unitconLib oUnit))
