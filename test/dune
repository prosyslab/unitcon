(rule
 (targets unitcon)
 (deps ../src/main.exe)
 (action
  (system "ln -sf ../src/main.exe ./unitcon")))

(rule
 (targets deps)
 (deps
  (source_tree ../deps))
 (action
  (system "cp -r ../deps ./deps")))

(rule
 (alias runtest)
 (deps
  unitcon
  deps
  (glob_files simple/*.java)
  (source_tree simple/unitcon-properties))
 (targets simple.output)
 (action
  (progn
   (ignore-stdout
    (run
     ./unitcon
     run
     simple
     --target
     Main.java:11
     --batch-size
     1
     --out-dir
     unitcon-simple
     --ignore-time
     --ignore-stdlib))
   (run cp unitcon-simple/unitcon-tests/UnitconTest1.java %{targets}))))

(rule
 (alias runtest)
 (action
  (diff simple.expected simple.output)))

